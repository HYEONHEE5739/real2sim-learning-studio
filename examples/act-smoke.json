{
  "dataset": {
    "repo_id": "workbench/native",
    "root": "datasets/train",
    "video_backend": "pyav",
    "use_imagenet_stats": false
  },
  "policy": {
    "type": "act",
    "device": "cuda",
    "push_to_hub": false,
    "pretrained_backbone_weights": null,
    "chunk_size": 10,
    "n_action_steps": 10,
    "dim_model": 128,
    "n_heads": 4,
    "dim_feedforward": 512,
    "n_encoder_layers": 1,
    "n_decoder_layers": 1,
    "n_vae_encoder_layers": 1
  },
  "output_dir": "workbench_runs/train-act",
  "steps": 2,
  "batch_size": 1,
  "num_workers": 0,
  "eval_freq": 0,
  "log_freq": 1,
  "save_freq": 1,
  "save_checkpoint": true,
  "seed": 1047,
  "wandb": {
    "enable": false
  },
  "use_policy_training_preset": false,
  "optimizer": {
    "type": "adamw",
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 10
  },
  "scheduler": {
    "type": "diffuser",
    "name": "constant",
    "num_warmup_steps": 0
  }
}
